# Database. SQLite for local dev; for PostgreSQL change `provider` in prisma/schema.prisma
# and use a postgresql:// URL here.
DATABASE_URL="file:./dev.db"

# Auth.js (generate with: openssl rand -base64 32)
AUTH_SECRET=""
# Optional. Auth.js trusts the request host, so this is rarely needed.
# AUTH_URL="http://localhost:3000"

# Optional social login. Providers are enabled only when both values are set.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_LINKEDIN_ID=""
AUTH_LINKEDIN_SECRET=""
