# ── Database ───────────────────────────────────────────────────────
# Local development uses SQLite. For PostgreSQL, change `provider` in prisma/schema.prisma
# to "postgresql" and use a postgresql:// URL here (see README, "Deploy to Vercel").
DATABASE_URL="file:./dev.db"

# ── Auth.js ────────────────────────────────────────────────────────
# Required. Generate one with: openssl rand -base64 32
AUTH_SECRET=""
# Optional. Auth.js trusts the request host, so this is rarely needed.
# AUTH_URL="http://localhost:3000"

# Optional social login. A provider is enabled only when both of its values are set.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_LINKEDIN_ID=""
AUTH_LINKEDIN_SECRET=""

# ── Site ───────────────────────────────────────────────────────────
# Public origin, used for Open Graph tags and the sitemap. On Vercel it falls back to
# VERCEL_PROJECT_PRODUCTION_URL, so you only need this for a custom domain.
# NEXT_PUBLIC_SITE_URL="https://meridian.example.com"

# ── Optional ───────────────────────────────────────────────────────
# Where uploaded library files are stored (local disk adapter). Default: ./uploads
# UPLOAD_DIR="uploads"
# Show the internal /design component gallery in production.
# ENABLE_DESIGN_PAGE="true"
